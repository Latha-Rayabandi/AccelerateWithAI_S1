# Select the AI provider to use: anthropic, groq, gemini, openai, or github.
# Anthropic is the recommended/default provider.
LLM_PROVIDER=anthropic

# Add your Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Pinned snapshot; update deliberately if Anthropic retires this model ID.
# If this model is not found, check https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: Get a Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Other options: openai/gpt-oss-120b, llama-3.1-8b-instant, llama-3.3-70b-versatile
# Groq may retire model IDs; for a 404/model_not_found error, check https://console.groq.com/docs/models
# gpt-oss models are reasoning models; callers must hide reasoning for downstream JSON parsing.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Get a Google Gemini API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: Get an OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Create a GitHub token at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini
